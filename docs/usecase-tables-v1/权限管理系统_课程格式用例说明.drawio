        <mxCell id="r9c1" value="唯一标识、字段映射、组织对应关系" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="448" width="364" height="42" />
        </mxCell>
        <mxCell id="r10c0" value="3. 系统展示问题、计划变更及影响。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="490" width="680" height="42" />
        </mxCell>
        <mxCell id="r10c1" value="问题行、新增／更新、停用和任职变化" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="490" width="364" height="42" />
        </mxCell>
        <mxCell id="r11c0" value="4. 总管理员确认预检通过的批次。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="532" width="680" height="42" />
        </mxCell>
        <mxCell id="r11c1" value="确定的导入内容、影响确认" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="532" width="364" height="42" />
        </mxCell>
        <mxCell id="r12c0" value="5. 系统导入资料并记录结果。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="574" width="680" height="42" />
        </mxCell>
        <mxCell id="r12c1" value="批次、实际新增／更新结果" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="574" width="364" height="42" />
        </mxCell>
        <mxCell id="r13c0" value="6. 总管理员查看执行报告。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
