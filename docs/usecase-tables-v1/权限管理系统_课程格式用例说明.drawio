        <mxCell id="r0c1" value="用例名称：配置管理员及管理范围" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550.0" y="70" width="522.0" height="42" />
        </mxCell>
        <mxCell id="r1c0" value="级别：用户目标" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#d8e3f3;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="112" width="1044" height="42" />
        </mxCell>
        <mxCell id="r2c0" value="包：后台管理资格" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="154" width="1044" height="42" />
        </mxCell>
        <mxCell id="r3c0" value="参与者：权限中心总管理员" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="196" width="1044" height="42" />
        </mxCell>
        <mxCell id="r4c0" value="描述：为各公司配置权限管理专员及共同管理的系统范围。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="238" width="1044" height="42" />
        </mxCell>
        <mxCell id="r5c0" value="触发事件：公司需要任命、替换专员，或调整可管理系统。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="280" width="1044" height="42" />
        </mxCell>
        <mxCell id="r6c0" value="前置条件：总管理员已登录；公司和候选人员资料已登记。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="322" width="1044" height="42" />
        </mxCell>
        <mxCell id="r7c0" value="主成功场景" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="364" width="680" height="42" />
        </mxCell>
        <mxCell id="r7c1" value="信息" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="364" width="364" height="42" />
        </mxCell>
        <mxCell id="r8c0" value="1. 总管理员选择公司。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="406" width="680" height="42" />
        </mxCell>
        <mxCell id="r8c1" value="总公司或分公司标识" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="406" width="364" height="42" />
        </mxCell>
        <mxCell id="r9c0" value="2. 系统展示当前专员及共同管理范围。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="448" width="680" height="42" />
        </mxCell>
        <mxCell id="r9c1" value="专员名单、公司部门范围、系统集合" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="448" width="364" height="42" />
        </mxCell>
        <mxCell id="r10c0" value="3. 总管理员调整可管理系统及专员名单。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="490" width="680" height="42" />
        </mxCell>
        <mxCell id="r10c1" value="最终专员名单、获准系统" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="490" width="364" height="42" />
        </mxCell>
        <mxCell id="r11c0" value="4. 系统展示变更和对后续管理的影响。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="532" width="680" height="42" />
        </mxCell>
        <mxCell id="r11c1" value="任免差异、系统增减、待处理申请影响" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="532" width="364" height="42" />
        </mxCell>
        <mxCell id="r12c0" value="5. 总管理员填写原因并确认。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="574" width="680" height="42" />
        </mxCell>
        <mxCell id="r12c1" value="变更原因、确认内容" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="574" width="364" height="42" />
        </mxCell>
        <mxCell id="r13c0" value="6. 系统保存配置并显示生效结果。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="616" width="680" height="42" />
        </mxCell>
        <mxCell id="r13c1" value="最新名单及管理范围" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="616" width="364" height="42" />
        </mxCell>
        <mxCell id="r14c0" value="扩展场景（编号对应主成功场景步骤）" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="658" width="680" height="42" />
        </mxCell>
        <mxCell id="r14c1" value="信息" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="658" width="364" height="42" />
        </mxCell>
        <mxCell id="r15c0" value="3a. 候选人没有账号：先按 UC-09 配套流程创建，再继续任命。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="700" width="680" height="42" />
        </mxCell>
        <mxCell id="r15c1" value="员工标识、后台账号" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="700" width="364" height="42" />
        </mxCell>
        <mxCell id="r16c0" value="3b. 候选人不符合任职条件、重复或超过3人：提示修正，不能保存。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="742" width="680" height="42" />
        </mxCell>
        <mxCell id="r16c1" value="问题人员、人数" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="742" width="364" height="42" />
        </mxCell>
        <mxCell id="r17c0" value="5a. 明确提交空名单或空系统集合：提示暂时无人／无系统可管理，确认后保存。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="784" width="680" height="42" />
        </mxCell>
        <mxCell id="r17c1" value="影响提示、原因" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="784" width="364" height="42" />
        </mxCell>
        <mxCell id="r18c0" value="5b. 资格无效或配置已变更：拒绝，重新读取后办理。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="826" width="680" height="42" />
        </mxCell>
        <mxCell id="r18c1" value="拒绝原因" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="826" width="364" height="42" />
        </mxCell>
        <mxCell id="r19c0" value="6a. 保存失败：保留原名单及范围。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="868" width="680" height="42" />
        </mxCell>
        <mxCell id="r19c1" value="失败说明" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="868" width="364" height="42" />
        </mxCell>
        <mxCell id="r20c0" value="其他：不经过 OA。每公司通常1～3人，同公司专员共享范围内角色；不按创建者分配管理权。公司边界不跨其他公司节点。任免或缩小范围不自动删除业务授权，不自动授予系统进入权限。员工停用使任命失效，恢复后总管理员重新任命。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="910" width="1044" height="68" />
        </mxCell>
        <mxCell id="footer" value="UC-07 · 课程简表 V1.1 · 2026-10-15 · 详细规则见 usecases-v1 对应文档" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="985" width="1044" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="UC-08" name="UC-08 查询授权审计记录">
