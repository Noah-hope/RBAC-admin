        <mxCell id="note1" value="多角色&lt;br&gt;只新增指定配对，不覆盖已有其他角色&lt;br&gt;同公司、同系统角色权限取并集&lt;br&gt;进入资格和功能也必须来自该公司、系统" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
