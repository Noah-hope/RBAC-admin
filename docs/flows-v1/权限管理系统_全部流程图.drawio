        <mxCell id="edit" value="维护本次需要变更的内容&lt;br&gt;系统、导航／功能菜单、操作、可见条件&lt;br&gt;功能归属、启停状态" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="625" width="360" height="110" />
        </mxCell>
        <mxCell id="valid" value="本次内容预检通过？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="790" width="300" height="110" />
        </mxCell>
        <mxCell id="correct" value="显示问题字段及原因&lt;br&gt;修改本次输入" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="800" width="240" height="85" />
        </mxCell>
        <mxCell id="preview" value="展示新增、修改、启停及引用影响&lt;br&gt;管理员填写修改原因" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="965" width="360" height="85" />
        </mxCell>
        <mxCell id="confirm" value="管理员确认保存？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="1110" width="300" height="110" />
        </mxCell>
        <mxCell id="cancel" value="取消本次未提交变更&lt;br&gt;原目录保持不变" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1120" width="240" height="85" />
        </mxCell>
        <mxCell id="cancel-end" value="本次办理结束" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="1260" width="180" height="45" />
        </mxCell>
        <mxCell id="recheck" value="提交时重新检查&lt;br&gt;管理员资格、版本和目录规则" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1280" width="360" height="85" />
        </mxCell>
        <mxCell id="fresh" value="提交时复核通过？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="1420" width="300" height="110" />
        </mxCell>
        <mxCell id="reject" value="拒绝本次保存，目录不变&lt;br&gt;提示资格失效、版本冲突或规则错误" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff1f0;strokeColor=#b9534e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1420" width="240" height="100" />
        </mxCell>
        <mxCell id="reject-end" value="本次保存结束" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff1f0;strokeColor=#b9534e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="1600" width="180" height="45" />
        </mxCell>
        <mxCell id="save" value="整体保存目录变更、版本和成功审计" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1585" width="360" height="80" />
        </mxCell>
        <mxCell id="saved" value="本次保存全部成功？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="1720" width="300" height="110" />
        </mxCell>
        <mxCell id="rollback" value="本次事务整体回滚&lt;br&gt;报告保存失败，不显示成功" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff1f0;strokeColor=#b9534e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1730" width="240" height="90" />
        </mxCell>
        <mxCell id="failure-end" value="本次保存结束" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff1f0;strokeColor=#b9534e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="1890" width="180" height="45" />
        </mxCell>
        <mxCell id="result" value="显示保存结果&lt;br&gt;区分已启用与仍停用的对象" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#ecf7ef;strokeColor=#44855e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="1895" width="360" height="85" />
        </mxCell>
        <mxCell id="end" value="完成" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#ecf7ef;strokeColor=#44855e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="445" y="2045" width="190" height="45" />
        </mxCell>
        <mxCell id="rule-a" value="目录校验&lt;br&gt;编码唯一、字段完整、同系统归属&lt;br&gt;父子无循环，禁止跨系统迁移&lt;br&gt;已引用目录不直接物理删除" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="580" width="410" height="155" />
        </mxCell>
        <mxCell id="rule-b" value="权限与菜单校验&lt;br&gt;操作必须属于本系统有效功能&lt;br&gt;角色只配置是否授予&lt;br&gt;启用功能菜单须绑定本功能&lt;br&gt;有效的查看／进入页面权限" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="795" width="410" height="180" />
        </mxCell>
        <mxCell id="rule-c" value="影响预览&lt;br&gt;停用导航目录会影响有效子树&lt;br&gt;重新启用只恢复尚有效的关联&lt;br&gt;已撤销／已失效授权不恢复" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="1020" width="410" height="145" />
        </mxCell>
        <mxCell id="rule-d" value="提交与失败处理&lt;br&gt;版本冲突：重新读取、核对后办理&lt;br&gt;资格失效：停止办理&lt;br&gt;其他规则错误：修改后重新办理&lt;br&gt;失败不得产生部分目录或半完成绑定" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="1405" width="410" height="175" />
        </mxCell>
        <mxCell id="rule-e" value="目录维护与授权分开&lt;br&gt;新系统有唯一 SYSTEM_ACCESS&lt;br&gt;不绑定菜单、不自动授予功能操作&lt;br&gt;新增目录不自动授予角色或员工&lt;br&gt;角色授权另走 UC-02／03 与 OA" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="1835" width="410" height="175" />
        </mxCell>
        <mxCell id="footer" value="说明：一次保存可只维护部分目录，不要求一次录入全部系统；新功能可先停用保存，合法绑定后再启用。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="2160" width="1190" height="55" />
        </mxCell>
