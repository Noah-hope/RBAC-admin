        <mxCell id="note1" value="多角色&lt;br&gt;只新增指定配对，不覆盖已有其他角色&lt;br&gt;同公司、同系统角色权限取并集&lt;br&gt;进入资格和功能也必须来自该公司、系统" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="447" width="460" height="122" />
        </mxCell>
        <mxCell id="note2" value="申请与失效&lt;br&gt;同一目标关系的未结束申请禁止重叠&lt;br&gt;角色或授权资格版本变化时旧批准不能强行执行&lt;br&gt;失效后需新申请，不能复活旧记录&lt;br&gt;批量一项不合法则整批不执行" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
