  <diagram id="uc-02" name="UC-02 创建角色并配置权限">
    <mxGraphModel dx="1400" dy="2853" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="2853" adaptiveColors="auto" math="0" shadow="0">
