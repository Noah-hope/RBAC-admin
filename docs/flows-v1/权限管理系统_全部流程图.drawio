          <mxGeometry as="geometry" x="85" y="485" width="180" height="45" />
        </mxCell>
        <mxCell id="select" value="选择已有系统或登记新系统" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
