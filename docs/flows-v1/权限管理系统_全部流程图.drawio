          <mxGeometry as="geometry" x="390" y="1817.5" width="360" height="125" />
        </mxCell>
        <mxCell id="approved_alt_0" value="保存为已驳回，业务数据不变&lt;br&gt;修改内容需新方案重新申请" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1840.0" width="260" height="75" />
        </mxCell>
        <mxCell id="approved_end" value="本次处理结束" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1955.0" width="180" height="47" />
        </mxCell>
        <mxCell id="check" value="自动读取固定申请，复核原资格依据&lt;br&gt;对应范围、目标条件、权限合法性及版本" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="375" y="2077.0" width="390" height="75" />
        </mxCell>
        <mxCell id="legal" value="全部目标仍合法且版本适用？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="2227.0" width="360" height="125" />
        </mxCell>
        <mxCell id="legal_alt_0" value="标记申请已失效，整批不执行&lt;br&gt;需重新申请，不能强行重试" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff1f0;strokeColor=#b9534e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="2249.5" width="260" height="75" />
