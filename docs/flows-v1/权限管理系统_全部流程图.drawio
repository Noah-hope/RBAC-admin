        <mxCell id="note0" value="人员与共享范围&lt;br&gt;每公司通常 1～3 名专员，可暂为零&lt;br&gt;同公司共享角色管理，不逐个指定角色&lt;br&gt;总公司范围不自动包含其他分公司" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
