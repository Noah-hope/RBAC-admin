        </mxCell>
        <mxCell id="note2" value="系统范围缩小&lt;br&gt;已有业务授权不自动撤销&lt;br&gt;公司专员原申请执行时仍复核当前公司范围&lt;br&gt;总管理员原申请按全局资格复核&lt;br&gt;处理人身份不能改变原申请依据" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
