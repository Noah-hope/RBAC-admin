          <mxGeometry as="geometry" x="360" y="965" width="360" height="85" />
        </mxCell>
        <mxCell id="confirm" value="管理员确认保存？" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#eef5ff;strokeColor=#32649a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="1110" width="300" height="110" />
        </mxCell>
        <mxCell id="cancel" value="取消本次未提交变更&lt;br&gt;原目录保持不变" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;" vertex="1" parent="1">
