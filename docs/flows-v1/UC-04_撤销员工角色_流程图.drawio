        </mxCell>
        <mxCell id="note1" value="历史与重新授予&lt;br&gt;员工已调离／停用不阻止管理本公司历史&lt;br&gt;已失效关系无需 OA 才能失去权限&lt;br&gt;旧撤销审批不能误撤后来重新授予的新关系" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="447" width="460" height="122" />
        </mxCell>
        <mxCell id="note2" value="审批等待&lt;br&gt;待审批只说明本次撤销尚未执行&lt;br&gt;其他合法变更仍可能使原授权失效&lt;br&gt;驳回不执行；变更后的实际状态照常有效" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
