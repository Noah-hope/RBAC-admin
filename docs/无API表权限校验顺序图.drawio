            <mxPoint x="130" y="990" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="c-note-caller" value="应用令牌只证明调用方是哪个应用，&lt;br&gt;不证明当前用户身份。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F4F8FC;strokeColor=#91A8BB;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-note-app" value="auth 用 TokenHash.sha256(token)&lt;br&gt;找应用；路径 appId 必须与令牌对应。&lt;br&gt;不一致抛 APPLICATION_MISMATCH → 403。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F4F8FC;strokeColor=#91A8BB;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="860" y="470" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c-note-db" value="查询链：sys_user_role → sys_role(BUSINESS)&lt;br&gt;→ sys_role_permission → sys_permission；&lt;br&gt;并要求 sys_user.status = ACTIVE。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F4F8FC;strokeColor=#91A8BB;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1330" y="620" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c-note-result" value="用户停用/不存在/无权限 → 200 allowed=false；&lt;br&gt;只有令牌无效返回 401，应用不匹配返回 403。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F4F8FC;strokeColor=#91A8BB;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1330" y="840" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-note-session" value="该接口在 WebConfig 中被排除出 SessionInterceptor，&lt;br&gt;不使用 Bearer 会话；userId 由调用方提交。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-note-self" value="权限中心自身管理接口（如 POST /api/v1/users）&lt;br&gt;当前不调用本接口，而是 SessionInterceptor&lt;br&gt;+ requireAdministrator + 部门范围。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=FangSong;fontStyle=1;fontSize=13;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c-title" value="当前后端实际权限检查顺序图（按权限标识，无 API 表）" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=SimHei;fontStyle=1;fontSize=30;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="1060" width="900" height="46" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
