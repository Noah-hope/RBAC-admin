  <diagram id="UC-02" name="UC-02 创建角色并配置权限">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1162" math="0" shadow="0">
      <root>
