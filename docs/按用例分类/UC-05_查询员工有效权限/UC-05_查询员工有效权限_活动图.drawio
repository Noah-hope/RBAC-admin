        <mxCell id="note1" value="统一有效性&lt;br&gt;只计算当前公司、当前系统有效授权&lt;br&gt;授权失效后恢复身份不能恢复旧关系&lt;br&gt;相同数据状态下须与 UC-06 判断一致" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3278.0" width="1940" height="185" />
        </mxCell>
        <mxCell id="note2" value="任一读取／计算发生服务错误&lt;br&gt;返回服务错误，终止本次调用&lt;br&gt;数据损坏和非法范围也属于错误&lt;br&gt;不伪装成功空集合，不默认放行" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3478.0" width="1940" height="185" />
        </mxCell>
        <mxCell id="note3" value="外部职责&lt;br&gt;服务凭据证明调用系统，不证明员工身份&lt;br&gt;员工标识来自业务系统受信登录上下文&lt;br&gt;公司数据过滤由业务系统实现&lt;br&gt;一期用简单 HTTP 调用演示" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3678.0" width="1940" height="185" />
