        </mxCell>
        <mxCell id="note0" value="无功能授权&lt;br&gt;有进入资格但没有功能权限时&lt;br&gt;canAccessSystem=true，菜单／操作为空&lt;br&gt;编辑权限不自动推导查看或菜单可见" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="260" width="460" height="122" />
        </mxCell>
        <mxCell id="note1" value="统一有效性&lt;br&gt;只计算当前公司、当前系统有效授权&lt;br&gt;授权失效后恢复身份不能恢复旧关系&lt;br&gt;相同数据状态下须与 UC-06 判断一致" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="447" width="460" height="122" />
        </mxCell>
        <mxCell id="note2" value="任一读取／计算发生服务错误&lt;br&gt;返回服务错误，终止本次调用&lt;br&gt;数据损坏和非法范围也属于错误&lt;br&gt;不伪装成功空集合，不默认放行" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="634" width="460" height="122" />
        </mxCell>
        <mxCell id="note3" value="外部职责&lt;br&gt;服务凭据证明调用系统，不证明员工身份&lt;br&gt;员工标识来自业务系统受信登录上下文&lt;br&gt;公司数据过滤由业务系统实现&lt;br&gt;一期用简单 HTTP 调用演示" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="821" width="460" height="147" />
        </mxCell>
