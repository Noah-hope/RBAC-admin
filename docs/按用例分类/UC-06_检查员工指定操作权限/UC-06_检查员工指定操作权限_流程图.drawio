        </mxCell>
        <mxCell id="note1" value="SYSTEM_ACCESS&lt;br&gt;进入权限直接检查，不递归要求进入资格&lt;br&gt;scope=null 表示不适用，不能解释成 ALL&lt;br&gt;进入权限也按当前公司、系统计算" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="447" width="460" height="122" />
        </mxCell>
        <mxCell id="note2" value="异常路径&lt;br&gt;未知／停用操作属于无权限&lt;br&gt;服务身份错误、系统调用不合法返回调用错误&lt;br&gt;数据库故障／非法范围返回服务错误&lt;br&gt;所有服务故障终止本次调用，不默认允许" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#1e3449;align=center;verticalAlign=middle;spacing=10;fillColor=#fff8e8;strokeColor=#bc9036;strokeWidth=1.5;align=left;fontSize=16;" vertex="1" parent="1">
