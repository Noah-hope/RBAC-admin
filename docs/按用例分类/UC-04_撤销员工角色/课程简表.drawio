  <diagram id="UC-04" name="UC-04 撤销员工角色">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1068" math="0" shadow="0">
      <root>
        <mxCell id="0" />
