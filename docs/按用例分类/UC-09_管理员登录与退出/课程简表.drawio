        </mxCell>
        <mxCell id="r14c1" value="信息" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="658" width="364" height="42" />
        </mxCell>
        <mxCell id="r15c0" value="2a. 账号、密码或管理资格无效：统一提示登录失败，不进入后台。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="700" width="680" height="42" />
        </mxCell>
        <mxCell id="r15c1" value="失败提示" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="700" width="364" height="42" />
        </mxCell>
        <mxCell id="r16c0" value="3a. 首次／重置后使用临时密码：只允许改密或退出；改密成功后重新登录。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="742" width="680" height="42" />
        </mxCell>
        <mxCell id="r16c1" value="原密码、新密码、确认值" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="742" width="364" height="42" />
        </mxCell>
        <mxCell id="r17c0" value="4a. 管理资格取消或范围缩小：后续操作按最新资格处理。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="784" width="680" height="42" />
        </mxCell>
        <mxCell id="r17c1" value="当前有效范围" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="784" width="364" height="42" />
        </mxCell>
        <mxCell id="r18c0" value="4b. 本人改密：验证并保存新密码，使全部旧登录失效，重新登录。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="826" width="680" height="42" />
        </mxCell>
        <mxCell id="r18c1" value="原密码、新密码" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="826" width="364" height="42" />
        </mxCell>
        <mxCell id="r19c0" value="6a. 已退出或登录过期：维持已退出状态，不恢复旧登录。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="868" width="680" height="42" />
        </mxCell>
        <mxCell id="r19c1" value="退出结果" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="868" width="364" height="42" />
        </mxCell>
        <mxCell id="r20c0" value="其他：仅本平台账号，不负责外部系统登录；无自由注册，不经 OA。配套：总管理员为有效员工创建唯一账号及临时密码，再由 UC-07 任命；可重置权限管理员密码并使旧登录失效。账号创建／密码重置不自动授予管理或业务权限。员工停用使任命失效；恢复后须重新任命，旧登录不能恢复资格。服务故障不作为密码错误。 总管理员另可创建、启停后台账号和重置密码；账号启停不改变员工业务权限，旧会话不复活。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="910" width="1044" height="120" />
        </mxCell>
