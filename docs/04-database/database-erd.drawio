        <mxCell id="e13" value="N:1" edge="1" parent="1" source="execution_success" target="audit_event" style="entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#456b87;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
