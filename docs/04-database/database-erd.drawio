  <diagram id="page-3" name="固定申请、OA与执行">
    <mxGraphModel dx="3037" dy="1743" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" background="#FFFFFF" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" parent="1" style="html=1;fontFamily=SimSun;fontStyle=1;text;whiteSpace=wrap;align=left;fontSize=17;fontColor=#17365D;" value="&lt;span style=&quot;font-size:27px&quot;&gt;固定申请、OA与执行&lt;/span&gt;&lt;br&gt;中心为业务核心表，周边为辅助表；中文表名／英文表名；不同表直连，同表自关联保留回线。&lt;br&gt;实线：物理FK（子→父），N:1，含可空；虚线：事务协调，无FK；全量键及空值见数据字典。" vertex="1">
          <mxGeometry height="115" width="2100" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="change_request" logicalTable="change_request" parent="1" role="core" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#D9E6F2;strokeColor=#17365D;strokeWidth=3;" tableLabel="权限变更申请表" value="&lt;b&gt;权限变更申请表&lt;/b&gt;&lt;br&gt;&lt;b&gt;change_request&lt;/b&gt;&lt;br&gt;草稿与固定申请共用生命周期；七响应模型不建七表&lt;hr&gt;PK id&lt;br&gt;kind&lt;br&gt;company_id&lt;br&gt;content&lt;br&gt;reason" vertex="1">
          <mxGeometry height="273" width="330" x="704" y="669" as="geometry" />
        </mxCell>
        <mxCell id="change_target" logicalTable="change_target" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="申请变更目标表" value="&lt;b&gt;申请变更目标表&lt;/b&gt;&lt;br&gt;&lt;b&gt;change_target&lt;/b&gt;&lt;br&gt;草稿目标/提交后实际清单的可检索投影；必须与对应content一致&lt;hr&gt;PK request_id&lt;br&gt;PK line_no&lt;br&gt;line_kind&lt;br&gt;company_id&lt;br&gt;system_id&lt;br&gt;department_id" vertex="1">
          <mxGeometry height="298" width="300" x="130" y="151" as="geometry" />
        </mxCell>
        <mxCell id="role_change_claim" logicalTable="role_change_claim" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="角色变更占用表" value="&lt;b&gt;角色变更占用表&lt;/b&gt;&lt;br&gt;&lt;b&gt;role_change_claim&lt;/b&gt;&lt;br&gt;当前角色配置通道；终态删除占用，历史不靠本表&lt;hr&gt;PK role_id&lt;br&gt;request_id" vertex="1">
          <mxGeometry height="198" width="260" x="690" y="201" as="geometry" />
        </mxCell>
        <mxCell id="relation_change_claim" logicalTable="relation_change_claim" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="授权关系变更占用表" value="&lt;b&gt;授权关系变更占用表&lt;/b&gt;&lt;br&gt;&lt;b&gt;relation_change_claim&lt;/b&gt;&lt;br&gt;当前关系变更通道；同来源去重，不阻塞其他来源&lt;hr&gt;PK baseline_id&lt;br&gt;request_id" vertex="1">
          <mxGeometry height="198" width="260" x="1240" y="201" as="geometry" />
        </mxCell>
        <mxCell id="oa_outbox" logicalTable="oa_outbox" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="OA投递待办表" value="&lt;b&gt;OA投递待办表&lt;/b&gt;&lt;br&gt;&lt;b&gt;oa_outbox&lt;/b&gt;&lt;br&gt;同一固定申请可靠投递待办及租约；不复制可变申请内容&lt;hr&gt;PK request_id&lt;br&gt;oa_instance_id&lt;br&gt;task_state&lt;br&gt;next_attempt_at&lt;br&gt;lease_token" vertex="1">
          <mxGeometry height="273" width="300" x="1760" y="163.5" as="geometry" />
        </mxCell>
        <mxCell id="oa_link" logicalTable="oa_link" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="OA审批关联表" value="&lt;b&gt;OA审批关联表&lt;/b&gt;&lt;br&gt;&lt;b&gt;oa_link&lt;/b&gt;&lt;br&gt;可靠外部审批关联；先由投递响应落地，回调不得抢绑&lt;hr&gt;PK request_id&lt;br&gt;oa_instance_id&lt;br&gt;oa_approval_id&lt;br&gt;accepted_at&lt;br&gt;created_at" vertex="1">
          <mxGeometry height="273" width="300" x="1403" y="669" as="geometry" />
        </mxCell>
        <mxCell id="oa_callback_event" logicalTable="oa_callback_event" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="OA回调事件表" value="&lt;b&gt;OA回调事件表&lt;/b&gt;&lt;br&gt;&lt;b&gt;oa_callback_event&lt;/b&gt;&lt;br&gt;OA实例+事件ID防重；同事件不同内容不得覆盖&lt;hr&gt;PK id&lt;br&gt;oa_instance_id&lt;br&gt;event_id&lt;br&gt;request_id&lt;br&gt;payload_digest" vertex="1">
          <mxGeometry height="273" width="300" x="1760" y="1443.5" as="geometry" />
        </mxCell>
        <mxCell id="oa_final_result" logicalTable="oa_final_result" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="OA最终审批结果表" value="&lt;b&gt;OA最终审批结果表&lt;/b&gt;&lt;br&gt;&lt;b&gt;oa_final_result&lt;/b&gt;&lt;br&gt;一申请一不可反转最终结果；新eventId不绕过&lt;hr&gt;PK request_id&lt;br&gt;first_event_id&lt;br&gt;decision&lt;br&gt;decided_at&lt;br&gt;comment" vertex="1">
          <mxGeometry height="273" width="300" x="1220" y="1443.5" as="geometry" />
        </mxCell>
        <mxCell id="execution_success" logicalTable="execution_success" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="权限变更执行成功表" value="&lt;b&gt;权限变更执行成功表&lt;/b&gt;&lt;br&gt;&lt;b&gt;execution_success&lt;/b&gt;&lt;br&gt;一申请一次成功凭据；业务写入/成功审计同事务&lt;hr&gt;PK request_id&lt;br&gt;audit_event_id&lt;br&gt;executed_at&lt;br&gt;result_snapshot" vertex="1">
          <mxGeometry height="248" width="300" x="130" y="1456" as="geometry" />
        </mxCell>
        <mxCell id="audit_event" logicalTable="audit_event" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="审计事件表" value="&lt;b&gt;审计事件表&lt;/b&gt;&lt;br&gt;&lt;b&gt;audit_event&lt;/b&gt;&lt;br&gt;追加式授权/管理审计和申请事件；不通过当前资料倒推历史&lt;hr&gt;PK id&lt;br&gt;occurred_at&lt;br&gt;event_type&lt;br&gt;actor_kind&lt;br&gt;actor_id" vertex="1">
          <mxGeometry height="273" width="300" x="130" y="1003.5" as="geometry" />
        </mxCell>
        <mxCell id="execution_attempt" logicalTable="execution_attempt" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="权限变更执行尝试表" value="&lt;b&gt;权限变更执行尝试表&lt;/b&gt;&lt;br&gt;&lt;b&gt;execution_attempt&lt;/b&gt;&lt;br&gt;本地执行尝试历史；业务失败回滚后独立记录&lt;hr&gt;PK id&lt;br&gt;request_id&lt;br&gt;attempt_no&lt;br&gt;outcome&lt;br&gt;failure_code" vertex="1">
