          <mxGeometry height="273" width="300" x="110" y="694" as="geometry" />
        </mxCell>
        <mxCell id="role_permission" logicalTable="role_permission" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="角色权限关联表" value="&lt;b&gt;角色权限关联表&lt;/b&gt;&lt;br&gt;&lt;b&gt;role_permission&lt;/b&gt;&lt;br&gt;当前有效角色配置集合；关系只表示授予&lt;hr&gt;PK role_id&lt;br&gt;PK permission_id&lt;br&gt;system_id" vertex="1">
          <mxGeometry height="223" width="260" x="150" y="1288.5" as="geometry" />
