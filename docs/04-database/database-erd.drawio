  <diagram id="page-4" name="导入、预览与可靠性">
    <mxGraphModel dx="2808" dy="1611" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" background="#FFFFFF" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" parent="1" style="html=1;fontFamily=SimSun;fontStyle=1;text;whiteSpace=wrap;align=left;fontSize=17;fontColor=#17365D;" value="&lt;span style=&quot;font-size:27px&quot;&gt;导入、预览与可靠性&lt;/span&gt;&lt;br&gt;中心为业务核心表，周边为辅助表；中文表名／英文表名；不同表直连，同表自关联保留回线。&lt;br&gt;实线：物理FK（子→父），N:1，含可空；虚线：事务协调，无FK；全量键及空值见数据字典。" vertex="1">
          <mxGeometry height="115" width="2100" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="import_file" logicalTable="import_file" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="导入文件表" value="&lt;b&gt;导入文件表&lt;/b&gt;&lt;br&gt;&lt;b&gt;import_file&lt;/b&gt;&lt;br&gt;导入文件元数据；文件本体受控存储且不可原地覆盖&lt;hr&gt;PK id&lt;br&gt;file_name&lt;br&gt;sha256&lt;br&gt;size_bytes&lt;br&gt;storage_ref" vertex="1">
          <mxGeometry height="273" width="300" x="130" y="183.5" as="geometry" />
        </mxCell>
        <mxCell id="import_batch" logicalTable="import_batch" parent="1" role="core" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#D9E6F2;strokeColor=#17365D;strokeWidth=3;" tableLabel="导入批次表" value="&lt;b&gt;导入批次表&lt;/b&gt;&lt;br&gt;&lt;b&gt;import_batch&lt;/b&gt;&lt;br&gt;冻结的预检与原子导入结果；成功sourceBatchId长期防重&lt;hr&gt;PK id&lt;br&gt;file_id&lt;br&gt;source_system&lt;br&gt;source_batch_id&lt;br&gt;import_type" vertex="1">
          <mxGeometry height="273" width="330" x="685" y="759" as="geometry" />
        </mxCell>
        <mxCell id="import_plan_row" logicalTable="import_plan_row" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="导入计划明细表" value="&lt;b&gt;导入计划明细表&lt;/b&gt;&lt;br&gt;&lt;b&gt;import_plan_row&lt;/b&gt;&lt;br&gt;冻结规范行及逐字段前后值；候选组织尚未建正式记录&lt;hr&gt;PK batch_id&lt;br&gt;PK row_number&lt;br&gt;PK plan_no&lt;br&gt;action&lt;br&gt;target_id&lt;br&gt;stable_code&lt;br&gt;company_code" vertex="1">
          <mxGeometry height="323" width="300" x="700" y="158.5" as="geometry" />
        </mxCell>
        <mxCell id="import_issue" logicalTable="import_issue" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="导入预检问题表" value="&lt;b&gt;导入预检问题表&lt;/b&gt;&lt;br&gt;&lt;b&gt;import_issue&lt;/b&gt;&lt;br&gt;冻结预检报告；仅总管理员可读&lt;hr&gt;PK id&lt;br&gt;batch_id&lt;br&gt;row_number&lt;br&gt;field&lt;br&gt;severity" vertex="1">
          <mxGeometry height="248" width="300" x="1240" y="196" as="geometry" />
        </mxCell>
