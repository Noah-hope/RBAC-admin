        <mxCell id="grant_baseline" logicalTable="grant_baseline" parent="1" role="core" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#D9E6F2;strokeColor=#17365D;strokeWidth=3;" tableLabel="角色授权关系基线表" value="&lt;b&gt;角色授权关系基线表&lt;/b&gt;&lt;br&gt;&lt;b&gt;grant_baseline&lt;/b&gt;&lt;br&gt;同一来源同角色的永久关系版本锚点；不随授权结束删除&lt;hr&gt;PK id&lt;br&gt;source_id&lt;br&gt;role_id&lt;br&gt;company_id&lt;br&gt;system_id" vertex="1">
          <mxGeometry height="273" width="330" x="1126" y="1036" as="geometry" />
        </mxCell>
        <mxCell id="role_grant" logicalTable="role_grant" parent="1" role="core" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#D9E6F2;strokeColor=#17365D;strokeWidth=3;" tableLabel="员工角色授予表" value="&lt;b&gt;员工角色授予表&lt;/b&gt;&lt;br&gt;&lt;b&gt;role_grant&lt;/b&gt;&lt;br&gt;一次具体来源授予；结束后重授必须新ID&lt;hr&gt;PK id&lt;br&gt;baseline_id&lt;br&gt;relation_version&lt;br&gt;source_epoch&lt;br&gt;status" vertex="1">
          <mxGeometry height="273" width="330" x="1029" y="1382" as="geometry" />
        </mxCell>
        <mxCell id="grant_employment_evidence" logicalTable="grant_employment_evidence" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="授权任职依据表" value="&lt;b&gt;授权任职依据表&lt;/b&gt;&lt;br&gt;&lt;b&gt;grant_employment_evidence&lt;/b&gt;&lt;br&gt;实际授予时适用任职依据；后续不因岗位改名改写&lt;hr&gt;PK grant_id&lt;br&gt;PK employment_id" vertex="1">
