          <mxGeometry height="273" width="300" x="1760" y="263.5" as="geometry" />
        </mxCell>
        <mxCell id="employee_source_identity" logicalTable="employee_source_identity" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="员工来源身份映射表" value="&lt;b&gt;员工来源身份映射表&lt;/b&gt;&lt;br&gt;&lt;b&gt;employee_source_identity&lt;/b&gt;&lt;br&gt;当前来源标识到内部员工的显式映射；重映射旧值另存审计&lt;hr&gt;PK id&lt;br&gt;source_system&lt;br&gt;source_key&lt;br&gt;employee_id&lt;br&gt;version" vertex="1">
