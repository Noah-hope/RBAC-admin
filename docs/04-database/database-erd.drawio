          <mxGeometry height="248" width="300" x="130" y="695" as="geometry" />
        </mxCell>
        <mxCell id="position" logicalTable="position" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="岗位表" value="&lt;b&gt;岗位表&lt;/b&gt;&lt;br&gt;&lt;b&gt;position&lt;/b&gt;&lt;br&gt;明确部门内岗位；不关联业务角色&lt;hr&gt;PK id&lt;br&gt;department_id&lt;br&gt;code&lt;br&gt;name&lt;br&gt;version" vertex="1">
