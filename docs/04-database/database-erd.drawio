  <diagram id="page-4" name="导入、预览与可靠性">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1600" pageHeight="1130">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;" value="导入、预览与可靠性&lt;br&gt;实体关系子视图；实线：物理FK（子→父），N:1，含可空；虚线：事务协调，无FK；全量键及空值见数据字典。">
          <mxGeometry x="40" y="20" width="1450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="import_file" value="&lt;b&gt;import_file&lt;/b&gt;&lt;br&gt;导入文件元数据；文件本体受控存储且不可原地覆盖&lt;hr&gt;PK id&lt;br&gt;file_name&lt;br&gt;sha256&lt;br&gt;size_bytes&lt;br&gt;storage_ref" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="40" y="140" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="import_batch" value="&lt;b&gt;import_batch&lt;/b&gt;&lt;br&gt;冻结的预检与原子导入结果；成功sourceBatchId长期防重&lt;hr&gt;PK id&lt;br&gt;file_id&lt;br&gt;source_system&lt;br&gt;source_batch_id&lt;br&gt;import_type" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="430" y="140" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="import_plan_row" value="&lt;b&gt;import_plan_row&lt;/b&gt;&lt;br&gt;冻结规范行及逐字段前后值；候选组织尚未建正式记录&lt;hr&gt;PK batch_id&lt;br&gt;PK row_number&lt;br&gt;PK plan_no&lt;br&gt;action&lt;br&gt;target_id&lt;br&gt;stable_code&lt;br&gt;company_code" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="820" y="140" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="import_issue" value="&lt;b&gt;import_issue&lt;/b&gt;&lt;br&gt;冻结预检报告；仅总管理员可读&lt;hr&gt;PK id&lt;br&gt;batch_id&lt;br&gt;row_number&lt;br&gt;field&lt;br&gt;severity" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="1210" y="140" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="organization_mapping" value="&lt;b&gt;organization_mapping&lt;/b&gt;&lt;br&gt;经过确认的完整来源路径映射；没有组织自动合并&lt;hr&gt;PK id&lt;br&gt;source_system&lt;br&gt;source_path&lt;br&gt;object_kind&lt;br&gt;company_id" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="40" y="460" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="employee_source_identity" value="&lt;b&gt;employee_source_identity&lt;/b&gt;&lt;br&gt;当前来源标识到内部员工的显式映射；重映射旧值另存审计&lt;hr&gt;PK id&lt;br&gt;source_system&lt;br&gt;source_key&lt;br&gt;employee_id&lt;br&gt;version" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="430" y="460" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="impact_preview" value="&lt;b&gt;impact_preview&lt;/b&gt;&lt;br&gt;五分钟固定预览；不是授权凭证&lt;hr&gt;PK id&lt;br&gt;creator_account_id&lt;br&gt;appointment_id&lt;br&gt;authority_snapshot&lt;br&gt;operation" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="820" y="460" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="preview_item" value="&lt;b&gt;preview_item&lt;/b&gt;&lt;br&gt;同一预览的可见员工/目标分页快照；禁止实时重算混页&lt;hr&gt;PK id&lt;br&gt;preview_id&lt;br&gt;item_kind&lt;br&gt;stable_key&lt;br&gt;safe_item" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="1210" y="460" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="http_idempotency" value="&lt;b&gt;http_idempotency&lt;/b&gt;&lt;br&gt;HTTP接受结果窗口；独立于OA与业务成功防重&lt;hr&gt;PK id&lt;br&gt;principal_id&lt;br&gt;http_method&lt;br&gt;canonical_path&lt;br&gt;idempotency_key" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="40" y="780" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="mutation_guard" value="&lt;b&gt;mutation_guard&lt;/b&gt;&lt;br&gt;一期本地写事务串行化锚点；没有业务权限含义&lt;hr&gt;PK id&lt;br&gt;revision" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eaf2f8;strokeColor=#456b87;fontSize=12;">
          <mxGeometry x="430" y="780" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="N:1" edge="1" parent="1" source="import_batch" target="import_file" style="entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#456b87;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="N:1" edge="1" parent="1" source="import_plan_row" target="import_batch" style="entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#456b87;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="N:1" edge="1" parent="1" source="import_issue" target="import_batch" style="entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#456b87;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="N:1" edge="1" parent="1" source="preview_item" target="impact_preview" style="entityRelationEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#456b87;fontSize=11;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="写事务先锁" edge="1" parent="1" source="import_batch" target="mutation_guard" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#777777;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="写事务先锁" edge="1" parent="1" source="http_idempotency" target="mutation_guard" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;strokeColor=#777777;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
