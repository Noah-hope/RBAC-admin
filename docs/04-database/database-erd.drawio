  <diagram id="page-1" name="组织与后台身份">
    <mxGraphModel dx="3100" dy="1779" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" background="#FFFFFF" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" parent="1" style="html=1;fontFamily=SimSun;fontStyle=1;text;whiteSpace=wrap;align=left;fontSize=17;fontColor=#17365D;" value="&lt;span style=&quot;font-size:27px&quot;&gt;组织与后台身份&lt;/span&gt;&lt;br&gt;中心为业务核心表，周边为辅助表；中文表名／英文表名；不同表直连，同表自关联保留回线。&lt;br&gt;实线：物理FK（子→父），N:1，含可空；虚线：事务协调，无FK；全量键及空值见数据字典。" vertex="1">
          <mxGeometry height="115" width="2100" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="company" logicalTable="company" parent="1" role="supporting" style="html=1;fontFamily=SimSun;fontStyle=1;rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#17365D;fillColor=#EAF2F8;strokeColor=#456B87;strokeWidth=2;" tableLabel="公司表" value="&lt;b&gt;公司表&lt;/b&gt;&lt;br&gt;&lt;b&gt;company&lt;/b&gt;&lt;br&gt;公司；无启停或公司层级授权&lt;hr&gt;PK id&lt;br&gt;code&lt;br&gt;name&lt;br&gt;version&lt;br&gt;created_at" vertex="1">
          <mxGeometry height="248" width="300" x="130" y="216" as="geometry" />
        </mxCell>
