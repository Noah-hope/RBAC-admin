          <mxGeometry as="geometry" x="708" y="810" width="364" height="42" />
        </mxCell>
        <mxCell id="r18c0" value="2c／4c. 查询服务故障：提示错误，不显示成没有日志。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
