          <mxGeometry as="geometry" x="708" y="852" width="364" height="42" />
        </mxCell>
        <mxCell id="r19c0" value="其他：只读，不修改、删除或重放历史。批准与执行成功分别展示；历史不等于当前权限。权限管理员查获准公司、来源部门子树及系统内记录；全局目录和任免日志仅总管理员查看。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
