          <mxGeometry as="geometry" x="708" y="616" width="364" height="42" />
        </mxCell>
        <mxCell id="r14c0" value="扩展场景（编号对应主成功场景步骤）" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="658" width="680" height="42" />
        </mxCell>
        <mxCell id="r14c1" value="信息" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#e2e2e2;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="658" width="364" height="42" />
        </mxCell>
        <mxCell id="r15c0" value="3a. 格式错误、身份或组织映射有歧义：修正后重新预检。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="700" width="680" height="42" />
        </mxCell>
        <mxCell id="r15c1" value="问题行、字段说明" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="700" width="364" height="42" />
        </mxCell>
        <mxCell id="r16c0" value="3b. 同员工多项合法任职：保留兼岗；完全重复资料不重复新增。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="742" width="680" height="42" />
        </mxCell>
        <mxCell id="r16c1" value="任职列表、重复提示" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="742" width="364" height="42" />
        </mxCell>
        <mxCell id="r17c0" value="3c. 已有角色、授权或历史引用的指定部门跨公司迁移：阻止本次变更。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="784" width="680" height="42" />
        </mxCell>
        <mxCell id="r17c1" value="受影响部门、原因" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="784" width="364" height="42" />
        </mxCell>
        <mxCell id="r18c0" value="4a. 预检后内容或目标发生变化：重新预检确认。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="826" width="680" height="42" />
        </mxCell>
        <mxCell id="r18c1" value="变化提示" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="826" width="364" height="42" />
        </mxCell>
        <mxCell id="r19c0" value="5a. 相同批次已执行：返回原结果；执行失败则整批不生效。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="868" width="680" height="42" />
        </mxCell>
        <mxCell id="r19c1" value="批次结果或失败原因" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="708" y="868" width="364" height="42" />
        </mxCell>
        <mxCell id="r20c0" value="其他：不经 OA，不自动建后台账号、任命、分角色或授予进入权限；漏行不等于离职。全局停用使全部业务授权及权限管理员任命失效；任职条件丧失只使相关授权／任命失效；结束最后任职后同批再就职不复权。历史保留，恢复不自动授予，分别重新走 UC-03／07。提供明确人员变更模板、内部稳定 ID 及来源映射。一期不要求真实 HR 接口。 总管理员可在员工页直接全局停用/恢复，恢复不复权；部门管理员仅按 UC-04 关闭本部门来源；不设计组织启停。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="910" width="1044" height="120" />
        </mxCell>
        <mxCell id="footer" value="UC-10 · 课程简表 V1.2 · 2026-10-15 · 详细规则见 usecases-v1 对应文档" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=none;fontStyle=0;" vertex="1" parent="1">
