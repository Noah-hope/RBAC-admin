          <mxGeometry as="geometry" x="708" y="574" width="364" height="42" />
        </mxCell>
        <mxCell id="r13c0" value="6. 系统复核并整体保存范围、任命及审计。" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#333333;fontStyle=0;" vertex="1" parent="1">
