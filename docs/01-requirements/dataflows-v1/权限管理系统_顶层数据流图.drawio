        </mxCell>
        <mxCell id="F01" source="global" target="center" value="F01 后台身份与管理请求&lt;br&gt;目录／角色／授权／账号与范围&lt;br&gt;导入指令、映射及审计查询" edge="1" parent="1" style="html=1;edgeStyle=none;noEdgeStyle=1;curved=0;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#4d6783;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243a52;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.13333333333333333;entryX=0.0;entryY=0.07142857142857142;exitPerimeter=0;entryPerimeter=0;">
