        <mxCell id="F09" source="business" target="center" value="F09 受信权限查询／校验请求&lt;br&gt;调用身份、员工、当前公司、系统&lt;br&gt;指定权限编码（单项校验）" edge="1" parent="1" style="html=1;edgeStyle=none;noEdgeStyle=1;curved=0;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#4d6783;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243a52;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.13333333333333333;entryX=1.0;entryY=0.8142857142857143;exitPerimeter=0;entryPerimeter=0;">
