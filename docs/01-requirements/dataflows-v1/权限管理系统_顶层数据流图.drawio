        <mxCell id="subtitle" value="系统上下文：一个整体处理过程、五类外部实体；箭头表示数据传递，不表示执行顺序" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;fontSize=20;align=left;">
