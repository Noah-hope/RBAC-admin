        <mxCell id="F10" source="center" target="business" value="F10 系统进入资格、可见菜单&lt;br&gt;允许功能操作／单项校验结果&lt;br&gt;调用或服务错误信息" edge="1" parent="1" style="html=1;edgeStyle=none;noEdgeStyle=1;curved=0;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#4d6783;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243a52;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.9571428571428572;entryX=0.0;entryY=0.8333333333333334;exitPerimeter=0;entryPerimeter=0;">
