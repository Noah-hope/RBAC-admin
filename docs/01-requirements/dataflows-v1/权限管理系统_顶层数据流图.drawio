        <mxCell id="center" value="0&lt;br&gt;集中权限管理系统" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=1;arcSize=18;fontSize=30;fillColor=#b9d7ff;strokeColor=#1c4e8a;strokeWidth=2;spacing=12;">
          <mxGeometry as="geometry" x="900" y="550" width="500" height="700" />
        </mxCell>
