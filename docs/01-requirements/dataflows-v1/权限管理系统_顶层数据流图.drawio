        </mxCell>
        <mxCell id="hr" value="HR 系统&lt;br&gt;人员组织数据来源" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=0;fillColor=#f7f9fc;strokeColor=#71869a;strokeWidth=2;spacing=12;">
          <mxGeometry as="geometry" x="1010" y="130" width="280" height="125" />
