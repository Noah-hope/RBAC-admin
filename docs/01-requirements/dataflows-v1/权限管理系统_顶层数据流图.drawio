        <mxCell id="title" value="集中权限管理系统 · 顶层数据流图" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;fontSize=32;align=left;">
