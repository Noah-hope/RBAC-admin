          <mxGeometry as="geometry" x="1900" y="300" width="300" height="420" />
        </mxCell>
        <mxCell id="business" value="业务系统后端" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=0;fillColor=#f7f9fc;strokeColor=#71869a;strokeWidth=2;spacing=12;">
          <mxGeometry as="geometry" x="1900" y="1120" width="300" height="300" />
        </mxCell>
        <mxCell id="note0" value="读图与层级&lt;br&gt;矩形：外部实体；圆角矩形：整体处理过程。&lt;br&gt;本图不展开数据库、内部模块和审批步骤。&lt;br&gt;此处“顶层”指上下文图，第一层分解另画。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;fontSize=20;align=left;spacing=14;">
          <mxGeometry as="geometry" x="45" y="1580" width="710" height="175" />
        </mxCell>
        <mxCell id="note1" value="一期外部对接&lt;br&gt;HR 以文件／模拟数据提供资料，管理员上传确认。&lt;br&gt;OA 模拟外部审批；结果接收不等于权限已生效。&lt;br&gt;业务系统使用简单、真实的 HTTP 调用演示。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;fontSize=20;align=left;spacing=14;">
          <mxGeometry as="geometry" x="790" y="1580" width="710" height="175" />
        </mxCell>
        <mxCell id="note2" value="边界与有效权限&lt;br&gt;普通员工不登录权限管理后台。&lt;br&gt;权限中心只管理功能权限，不设计数据权限。&lt;br&gt;没有权限与调用失败／服务故障分别返回。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#243a52;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;fontSize=20;align=left;spacing=14;">
          <mxGeometry as="geometry" x="1535" y="1580" width="710" height="175" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
