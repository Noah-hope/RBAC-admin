        <mxCell id="F02" source="center" target="global" value="F02 身份与全局管理范围&lt;br&gt;配置数据、办理状态&lt;br&gt;导入报告及审计记录" edge="1" parent="1" style="html=1;edgeStyle=none;noEdgeStyle=1;curved=0;rounded=0;endArrow=block;endFill=1;endSize=10;strokeColor=#4d6783;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#243a52;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.32857142857142857;entryX=1.0;entryY=0.8333333333333334;exitPerimeter=0;entryPerimeter=0;">
