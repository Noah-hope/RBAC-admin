        </mxCell>
        <mxCell id="note-1" value="列表、数量、详情与关联事件使用相同范围；历史名称、组织与差异取记录时快照。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1218" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="D2 仅核对当前操作者资格，不用当前员工姓名或调岗后组织覆盖历史审计。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1254" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="本处理只读 D1／D2／D6／D7，不修改或重放任何审计、申请或授权记录。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="审计不返回明文密码、凭据或无关人员资料；本图沿用共享逻辑存储编号，不画物理表结构。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
