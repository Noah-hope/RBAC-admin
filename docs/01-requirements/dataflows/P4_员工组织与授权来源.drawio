        </mxCell>
        <mxCell id="label-L42" value="文件批次、预检与提交报告" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=26;fontColor=#18344D;" vertex="1" parent="1" flowRef="L42">
          <mxGeometry x="1480" y="2760.0" width="860" height="30" as="geometry" />
        </mxCell>
        <mxCell id="detail-L42-0" value="文件与批次、映射／预检问题、冻结计划和实际提交报告" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=22;fontColor=#18344D;" vertex="1" parent="1" flowRef="L42">
          <mxGeometry x="1480" y="2793.0" width="860" height="27" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="总管理员办理组织人事导入及员工全局启停；权限管理员仅按单项任命关闭范围内离岗来源。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2962" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="预检只保存 D8 文件与冻结计划；正式确认后整批原子更新人员、相关持久失效及成功审计。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2998" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="明确结束任职／停用才产生相应失效，不从文件缺行推断离职；初始化不自动创建账号、任命或授权。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3034" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="离岗／人员条件丧失时持久推进来源周期，整份相关申请及占用／待办失效；不等待 OA。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3070" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="员工全局停用使授权、任命和旧会话失效；恢复只恢复身份，不自动恢复旧授权、任命或会话。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3106" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="同批离岗后重新任职也保留已发生的周期推进；仅原管理员离任不单独阻止合法已提交申请执行。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3142" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="导入校验历史引用，阻止不合法组织迁移；读取历史审计不代表可修改历史事件。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3178" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-7" value="D8 为文件／批次／预检报告，D2 为正式组织与身份映射；全部均为逻辑存储分类。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="3214" width="2720" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>