        <mxCell id="note-0" value="专用 OA 身份、可靠审批关联、固定版本与摘要均须匹配；普通管理会话不能伪造批准。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2310" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="接收最终结果与执行生效分开；驳回只记结果，不改 D4／D5；重复通知返回已记录结果。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2346" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="批准后自动复核并执行固定整份清单；全部业务变更、执行状态与成功审计同事务成功或回滚。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2382" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="只按申请类型写入 D4 或 D5；失败保留已批准依据，服务端恢复后重新复核，不要求管理员接手。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2418" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="复核原范围与目标条件；来源已关闭、周期／版本陈旧则失效，员工恢复不放行迟到旧批准。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2454" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="原申请人离任或范围暂时无人不单独阻止合法执行；查询人的更大权限不能替换原申请依据。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2490" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="返回仅含响应时可确认的接收／处理状态，不虚构额外主动推送；逻辑存储不等同于物理表。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2526" width="2720" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>