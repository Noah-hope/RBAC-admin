        </mxCell>
        <mxCell id="key-0" value="深蓝圆角框：处理；灰色矩形：外部实体；浅黄色双横线框：逻辑数据存储。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="3768" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="key-1" value="同名实体或同一 D 编号在不同分区重复引用，仍表示同一个对象，并未新增存储。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="3830" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="key-2" value="示例：P3 写入 D6 固定申请，P5 从同一 D6 读取并执行；P6 读取更新后的 D4、D5。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="3892" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="key-3" value="本页仍是第一层总图：P1～P7 没有继续分解；分区只用于减少线条交叉。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="3954" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="key-4" value="P3 提交不生效；P4 人员／离岗失效直接关权；P5 仅按可信批准执行。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="4016" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="key-5" value="图中保留原 57 条主要数据流；公共身份／范围及执行复核的辅助读取见 P1～P7 分图。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="2220" y="4078" width="1940" height="45" as="geometry" />
        </mxCell>
        <mxCell id="footer-0" value="编号表示处理或共享数据标识，不表示执行顺序。相同 D 编号的数据在所有分区间共享。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="4282" width="4180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="footer-1" value="HR 文件由总管理员上传；预检不更新正式人员数据；恢复员工不自动恢复旧授权。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=25;fontColor=#18344D;" vertex="1" parent="1">
