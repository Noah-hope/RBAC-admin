        <mxCell id="note-0" value="D1、D2、D3、D6、D7 沿用第一层相同编号：它们是逻辑数据存储，并非五张数据库表。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1770" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="P1-A01／P1-A02 补充了总图省略的系统有效性与原申请影响读取；原 P1 的九条主要数据流全部保留。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1805" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="普通权限管理员仅办理本人会话；创建／启停／重置他人账号及配置任命范围仅由总管理员办理。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1840" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="每次按最新账号、员工与单项任命校验；任命不能拼接。临时密码仅可改密／退出；空系统集合不自动取消后台资格。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1875" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="范围实质缩小使不再合法的申请失效；仅原管理员离任不单独阻止合法申请执行。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1910" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="账号／范围变更及成功审计原子保存；不记录明文密码、密码哈希或会话凭据到审计。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1945" width="2720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="任命与账号管理不授予业务角色，不写 D4／D5，也不经过 OA；登录运行日志不等同于 D7 授权管理审计。" style="html=1;fontFamily=SimSun;fontStyle=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;fontSize=23;fontColor=#18344D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1980" width="2720" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>