        </mxCell>
        <mxCell id="note1" value="历史与重新授予&lt;br&gt;只读查看获准来源历史；仍有效来源才可一般撤销&lt;br&gt;已失效关系无需 OA 才能失去权限&lt;br&gt;旧撤销审批不能误撤后来重新授予的新关系" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4364.0" width="2920" height="185" />
        </mxCell>
        <mxCell id="note2" value="审批等待&lt;br&gt;待审批只说明本次撤销尚未执行&lt;br&gt;其他合法变更仍可能使原授权失效&lt;br&gt;驳回不执行；变更后的实际状态照常有效" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4564.0" width="2920" height="185" />
        </mxCell>
      </root>
    </mxGraphModel>
