        <mxCell id="note0" value="撤销边界&lt;br&gt;不删除角色、不修改角色权限、不停用员工&lt;br&gt;不影响其他员工或其他角色的重合权限&lt;br&gt;相同操作仍有有效来源则继续保留" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
