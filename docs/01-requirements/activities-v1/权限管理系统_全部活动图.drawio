        <mxCell id="end-inner" value="" vertex="1" parent="lane-center" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;ellipse;fillColor=#23384f;strokeColor=#23384f;">
          <mxGeometry as="geometry" x="768.0" y="3458.0" width="14" height="14" />
        </mxCell>
        <mxCell id="note0" value="后台与员工&lt;br&gt;导入员工不自动创建后台账号&lt;br&gt;只有账号没有有效任命不能进入管理后台&lt;br&gt;成功登录不授予外部业务系统权限" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3728.0" width="1940" height="185" />
        </mxCell>
        <mxCell id="note1" value="停用与恢复&lt;br&gt;员工停用使业务授权及权限管理员任命失效&lt;br&gt;恢复身份不恢复旧任命，需 UC-07 重新任命&lt;br&gt;后台账号停用不等于员工全局停用" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3928.0" width="1940" height="185" />
        </mxCell>
        <mxCell id="note2" value="会话与密码&lt;br&gt;普通退出只结束当前会话&lt;br&gt;改密／重置使所有旧会话失效&lt;br&gt;临时密码改密前不能访问管理接口&lt;br&gt;配套创建、改密、重置见其他页签" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4128.0" width="1940" height="185" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
