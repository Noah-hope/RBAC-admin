        <mxCell id="note1" value="统一有效性&lt;br&gt;只计算当前公司、当前系统有效授权&lt;br&gt;授权失效后恢复身份不能恢复旧关系&lt;br&gt;相同数据状态下须与 UC-06 判断一致" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
