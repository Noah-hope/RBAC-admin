        <mxCell id="note1" value="保密&lt;br&gt;响应、日志与审计不返回密码或哈希&lt;br&gt;没有自由注册，也不经过 OA&lt;br&gt;重复同内容请求返回原结果" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
