        </mxCell>
        <mxCell id="note2" value="申请与失效&lt;br&gt;同一目标关系的未结束申请禁止重叠&lt;br&gt;角色或授权资格版本变化时旧批准不能强行执行&lt;br&gt;失效后需新申请，不能复活旧记录&lt;br&gt;批量一项不合法则整批不执行" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
