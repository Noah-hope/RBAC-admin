        <mxCell id="note0" value="角色归属&lt;br&gt;一个公司＋一个系统，可限定任职部门&lt;br&gt;岗位不自动绑定角色&lt;br&gt;公司共享角色仅总管理员维护&lt;br&gt;部门角色按指定范围协作" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4182.0" width="2920" height="185" />
        </mxCell>
        <mxCell id="note1" value="草稿与当前配置&lt;br&gt;新角色草稿不可分配；允许仅保存草稿&lt;br&gt;未提交的新角色草稿可按规则删除&lt;br&gt;已有角色修改待审批时旧配置继续有效&lt;br&gt;一个角色仅一份未结束配置方案" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4382.0" width="2920" height="185" />
        </mxCell>
        <mxCell id="note2" value="功能权限&lt;br&gt;目录登记查看、编辑等独立操作&lt;br&gt;角色仅选择是否授予，不配置数据范围&lt;br&gt;角色可只含进入权限或只含功能权限&lt;br&gt;正式配置不得为空" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4582.0" width="2920" height="185" />
        </mxCell>
        <mxCell id="note3" value="OA 与执行&lt;br&gt;驳回后复制新方案修改并重新审批&lt;br&gt;批准不等于已执行，失败显示待恢复&lt;br&gt;原申请人离任不单独阻止合法方案执行&lt;br&gt;本平台不实现 OA 内部审批流程" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="4782.0" width="2920" height="185" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
