        </mxCell>
        <mxCell id="note1" value="SYSTEM_ACCESS&lt;br&gt;进入权限直接检查，不递归要求进入资格&lt;br&gt;只判断有无权限，不返回数据范围&lt;br&gt;进入权限也按当前公司、系统计算" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3289.0" width="1940" height="185" />
        </mxCell>
        <mxCell id="note2" value="异常路径&lt;br&gt;未知／停用操作属于无权限&lt;br&gt;服务身份错误、系统调用不合法返回调用错误&lt;br&gt;数据库故障／权限数据损坏返回服务错误&lt;br&gt;所有服务故障终止本次调用，不默认允许" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#23384f;align=center;verticalAlign=middle;rounded=0;fillColor=#fff8e8;strokeColor=#c4a34f;align=left;spacing=12;fontSize=17;">
          <mxGeometry as="geometry" x="40" y="3489.0" width="1940" height="185" />
        </mxCell>
      </root>
    </mxGraphModel>
