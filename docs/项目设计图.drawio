        <mxCell id="rbac1-ddd-domain-model-c2" value="RBAC1 面向对象类图 · DDD 领域模型全景（7 领域子包）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="4120.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-domain-model-c3" value="范围：com.rbac.rbac1ddd.domain。聚合间通过 ID 解耦引用，跨聚合图遍历与最小权限筛选由不可变领域服务承载，零 Spring/JPA 依赖。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="92.0" width="4120.0" height="34.0" as="geometry" />
        </mxCell>
