      <mxCell id="rbac1db-role-inheritance-cell-3-0" parent="rbac1db-role-inheritance-row-3" value="联合主键 (role_id, inherited_role_id)。&lt;br&gt;两列外键 → sys_role.id，删除限制 RESTRICT。&lt;br&gt;反向索引 inherited_role_id；CHECK：两列不相等。&lt;br&gt;只记录直接继承，不保存传递闭包。" vertex="1" connectable="0" style="shape=partialRectangle;html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#B91C1C;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=22;colspan=4;">
