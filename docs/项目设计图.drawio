        <mxCell id="rbac1-ddd-seq-role-c42" value="&lt;span style=&quot;background:#FFFFFF;padding:0 3px&quot;&gt;18. settle(holders)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=FangSong, STFangsong, serif;fontSize=19;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1389.5" y="2350.0" width="216.2" height="28.0" as="geometry" />
        </mxCell>
