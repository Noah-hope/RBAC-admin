        <mxCell id="rbac1-ddd-package-c33" value="logging&lt;br&gt;&lt;span style=&quot;font-family:FangSong, STFangsong, serif;font-size:18px;font-weight:bold;color:#3A5570&quot;&gt;LayerLoggingAspect 分层日志&lt;/span&gt;" style="shape=folder;html=1;tabWidth=116;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
