        </mxCell>
        <mxCell id="rbac1-ddd-package-c39" value="虚线空心箭头：包依赖（箭头指向被依赖的包）。domain 不依赖任何其他层，只在内部模块之间引用，例如 request → role、permission。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1790.0" width="1318.4" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-package-c40" value="infrastructure 实现 domain 中的 RoleRepository、UserRepository 等仓储接口，以及 application 中的 OperationRecorder、SessionStore、PasswordHasher、TokenIssuer 等端口。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1824.0" width="1846.4" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rbac1-structured-package" name="RBAC1-结构化-包图-后端分层">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2460" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rbac1-structured-package-c1" value="RBAC1 结构化包图 · rbac1-structured 后端分层" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="2360.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c2" value="包 com.rbac.rbac1。面向功能的经典三层结构：controller 调 service，service 集中全部业务规则并直接依赖 mapper、entity、dto 与 vo；无独立领域层和仓储端口。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="92.0" width="2360.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c3" value="" style="line;strokeWidth=1.5;strokeColor=#B3C5D4;fillColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="132.0" width="2360.0" height="4.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c4" value="rbac1" style="shape=folder;html=1;tabWidth=110;tabHeight=44;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.2;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=26;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="160.0" width="2380.0" height="1440.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c5" value="controller&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;RoleController、PermissionRequestController、RoleCreationRequestController、SessionInterceptor、RestExceptionHandler 等&lt;/font&gt;" style="shape=folder;html=1;tabWidth=148;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="90.0" y="240.0" width="1580.0" height="210.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c6" value="dto&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;RoleDTO、PermissionReviewDTO、RoleCreationReviewDTO 等请求体与校验&lt;/font&gt;" style="shape=folder;html=1;tabWidth=110;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="90.0" y="560.0" width="460.0" height="240.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c7" value="vo&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;RoleDetailsVO、PermissionRequestVO、RoleCreationRequestVO 等响应体&lt;/font&gt;" style="shape=folder;html=1;tabWidth=110;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="90.0" y="900.0" width="460.0" height="240.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c8" value="service&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;RoleService、RolePermissionService、PermissionRequestService、RoleCreationRequestService、RequestStatusService、OperationLogService、ApprovalRules、DuplicateKeys（全部业务规则与事务）&lt;/font&gt;" style="shape=folder;html=1;tabWidth=135;tabHeight=44;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.2;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=26;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="680.0" y="560.0" width="990.0" height="470.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c9" value="config&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;LayerLoggingAspect 分层日志、JWT/Argon2 认证、WebConfig&lt;/font&gt;" style="shape=folder;html=1;tabWidth=110;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1840.0" y="560.0" width="520.0" height="470.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c10" value="mapper&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;RoleMapper、RolePermissionMapper、RoleInheritanceMapper、UserRoleMapper、PermissionRequestMapper、RoleCreationRequestMapper 等 Spring Data JPA 接口&lt;/font&gt;" style="shape=folder;html=1;tabWidth=110;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="680.0" y="1150.0" width="990.0" height="190.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c11" value="entity&lt;br&gt;&lt;font style=&quot;font-family:FangSong, STFangsong, serif;font-size:19px;color:#3A5570;&quot;&gt;Role、RolePermission、RoleInheritance、Permission、PermissionRequest、RoleCreationRequest、UserAccount、UserRole（贫血 JPA 实体 + 状态常量，无业务方法）&lt;/font&gt;" style="shape=folder;html=1;tabWidth=110;tabHeight=34;tabPosition=left;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;whiteSpace=wrap;fillColor=#EAF2F8;strokeColor=#17365D;strokeWidth=1.6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=21;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
