        </mxCell>
        <mxCell id="rbac1-structured-seq-review-c93" value="与 DDD 版对比：没有 PermissionRequest.approve/reject/settleWith 和 ApprovalCandidates 领域对象，全部状态流转和候选计算集中在 PermissionRequestService；requireVisible 内部同时校验部门管理员审核范围。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2778.0" width="2204.4" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
