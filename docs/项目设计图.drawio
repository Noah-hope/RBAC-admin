          </mxGeometry>
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c44" value="&lt;span style=&quot;background:#FFFFFF;padding:0 3px&quot;&gt;19. result = details(role)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=FangSong, STFangsong, serif;fontSize=19;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="555.4" y="2438.0" width="290.6" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-e45" value="" style="html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=1.8;strokeColor=#17365D;dashed=1;dashPattern=8 6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="531.4" y="2564.0" as="sourcePoint" />
            <mxPoint x="193.4" y="2564.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c46" value="&lt;span style=&quot;background:#FFFFFF;padding:0 3px&quot;&gt;result: RoleDetailsResult&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=FangSong, STFangsong, serif;fontSize=19;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="222.4" y="2534.0" width="280.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c101" value="RBAC1 面向对象顺序图 · 修改角色的直接权限与继承关系" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="4224.1" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c102" value="范围：RoleApplicationService.update（@Transactional）。operator.requireTotalAdmin() 的身份检查省略；规则全部在 Role 和 RoleHierarchy 中。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="92.0" width="4224.1" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c103" value="" style="line;strokeWidth=1.5;strokeColor=#B3C5D4;fillColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="132.0" width="4224.1" height="4.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c104" value="同步消息：实线实心箭头并编号；回复与异常：虚线空心箭头，不编号。«MetaClass» : Role 表示私有静态方法 validateSelection 的调用。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2654.0" width="1345.6" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c105" value="validateSelection 校验权限存在、父角色为业务角色、不新增已继承的直接权限，违规同样抛出 INVALID_REQUEST。任一异常都使事务回滚，角色保持原配置。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2688.0" width="1500.8" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-c106" value="全部校验通过后 Role 才替换名称、说明、直接权限和父角色；随后重新结算本角色及全部后代角色持有人的待审核申请。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2722.0" width="1127.2" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-role-note-extra" value="注：入口 requireTotalAdmin 鉴权守卫已省略；ensureEditable 对预置管理角色抛出 FORBIDDEN，save(role) 重名时由仓储翻译为 DUPLICATE。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2756.0" width="1463.6" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
