        <mxCell id="rbac1-structured-class-creation-c84" value="实线空心箭头：关联（字段，箭头旁为 role name）　虚线空心箭头：依赖（参数、局部变量、返回值）。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1468.0" width="1036.3" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-class-creation-c85" value="与 DDD 版对比：RoleCreationRequest 为贫血单表实体，权限列表和父角色快照由 Service 通过两张关联表 Mapper 分别读取拼装；审批通过时调用 RoleService.create 加入同一事务。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1502.0" width="1836.3" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
