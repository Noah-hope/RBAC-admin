        <mxCell id="db-common-title" parent="1" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=29;" value="约束与事务" vertex="1">
