        <mxCell id="rbac1-ddd-seq-review-c112" value="RBAC1 面向对象顺序图 · 审核权限申请" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="4796.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-review-c113" value="范围：PermissionRequestApplicationService.review（@Transactional）。requireVisible 内的审核范围判断（canReview）和结果组装 view 未展开。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="92.0" width="4796.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-review-c114" value="" style="line;strokeWidth=1.5;strokeColor=#B3C5D4;fillColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="132.0" width="4796.0" height="4.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-review-c115" value="同步消息：实线实心箭头并编号；回复与异常：虚线空心箭头，不编号。«MetaClass» : ApprovalCandidates 表示静态工厂方法 evaluate。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="3030.0" width="1330.4" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-review-c116" value="候选角色按全部有效权限（直接 + 继承，含所有应用）计算；通过时只保存用户与所选业务角色的关联，不复制继承权限。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="3064.0" width="1133.6" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-review-note-extra" value="注：requireVisible 内部同时校验部门管理员的审核范围（departments.loadTree），越界与不存在均抛出 NOT_FOUND。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="3098.0" width="1216.9" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
