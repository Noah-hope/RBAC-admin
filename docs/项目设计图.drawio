        </mxCell>
        <mxCell id="rbac1-structured-package-c24" value="虚线空心箭头表示包依赖（与源码 import 方向一致）。结构化实现采用自上而下依赖：controller → service → mapper → entity。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1640.0" width="1319.6" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-package-c25" value="与 DDD 版的差异：没有独立 domain 层和仓储端口，没有依赖倒置；Service 直接消费 DTO、返回 VO，并通过 JPA Mapper 操作贫血实体表记录。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1674.0" width="1450.2" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rbac1-swarm-deployment" name="RBAC1-部署图-DockerSwarm集群">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2680" pageHeight="1620" background="#FFFFFF" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rbac1-swarm-deployment-c2" value="RBAC1 部署架构图 · Docker Swarm 双系统统一身份集群拓扑" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="2600.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c3" value="范围：deploy/stack.yml 与课程项目管理系统联调。Swarm 按节点标签隔离部署，经加密 Overlay 网络 rbac-net 与 Secrets 通信。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="92.0" width="2600.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c4" value="" style="line;strokeWidth=1.5;strokeColor=#B3C5D4;fillColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="132.0" width="2600.0" height="4.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c5" value="客户端浏览器层（外部访问）　（管理员 / 普通员工 / 课程师生）" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fillColor=#F7FAFC;strokeColor=#8CA4B9;strokeWidth=2.2;dashed=1;dashPattern=10 6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=22;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="185.0" width="2520.0" height="225.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c6" value="Docker Swarm 集群（Manager 编排调度 · Overlay 网络 rbac-net · Swarm Secrets 凭据注入）　（docker stack deploy -c deploy/stack.yml rbac）" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;fillColor=#F4F8FB;strokeColor=#17365D;strokeWidth=2.2;dashed=1;dashPattern=10 6;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=22;fontStyle=1;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="80.0" y="475.0" width="2520.0" height="975.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c7" value="&lt;div style=&quot;font-size:15px&quot;&gt;«device»&lt;/div&gt;&lt;b&gt;权限中心浏览器端&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;入口：http://&amp;lt;前端节点IP&amp;gt;:8088&lt;br&gt;SPA：Vue 3 + Element Plus 管理台&lt;br&gt;携带：Bearer JWT + X-Application-Code" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="220.0" y="232.0" width="580.0" height="158.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c8" value="&lt;div style=&quot;font-size:15px&quot;&gt;«device»&lt;/div&gt;&lt;b&gt;课程管理系统浏览器端&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;入口：http://&amp;lt;课程节点IP&amp;gt;:8089&lt;br&gt;师生工作台与课程管理菜单&lt;br&gt;跨域直连权限中心查菜单许可与选人目录" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1860.0" y="232.0" width="620.0" height="158.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c9" value="&lt;div style=&quot;font-size:15px&quot;&gt;«node» worker (rbac.role=frontend)&lt;/div&gt;&lt;b&gt;rbac_frontend · Nginx 网关容器&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;公网发布：8088 -&amp;gt; 容器 80&lt;br&gt;静态托管：权限管理前端 dist / 设计图册&lt;br&gt;反向代理：/api/v1/* 与 /auth/* -&amp;gt; RBAC_API_UPSTREAM" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="150.0" y="560.0" width="680.0" height="185.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c10" value="&lt;div style=&quot;font-size:15px&quot;&gt;«node» worker (课程系统节点)&lt;/div&gt;&lt;b&gt;course-project-management 前后端&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;课程前端 Nginx (:8089) + 课程后端 (:8080)&lt;br&gt;登录委托：POST /auth/login 签发多受众 JWT&lt;br&gt;验签与鉴权：/.well-known/jwks.json · /auth/api-permissions/*" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1790.0" y="560.0" width="730.0" height="185.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c11" value="&lt;div style=&quot;font-size:15px&quot;&gt;«node» worker (rbac.role=structured)&lt;/div&gt;&lt;b&gt;rbac_structured · 结构化后端 (:8080)&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;镜像：rbac1-structured:1.0.0（Java 21 / Spring Boot）&lt;br&gt;日志挂载：/root/rbac/logs/structured -&amp;gt; /app/logs&lt;br&gt;职责：47 项统一接口 · Flyway V1–V2 建表迁移" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="150.0" y="880.0" width="680.0" height="185.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c12" value="&lt;div style=&quot;font-size:15px&quot;&gt;«node» worker (rbac.role=ddd)&lt;/div&gt;&lt;b&gt;rbac_ddd · 面向对象 DDD 后端 (:8080)&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;镜像：rbac1-ddd:1.0.0（纯 JDK 领域层 + JPA 适配器）&lt;br&gt;日志挂载：/root/rbac/logs/ddd -&amp;gt; /app/logs&lt;br&gt;职责：与结构化版等价的 47 项契约 · 按需热切换" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="980.0" y="880.0" width="680.0" height="185.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c13" value="&lt;div style=&quot;font-size:15px&quot;&gt;«executionEnvironment» Swarm 控制面&lt;/div&gt;&lt;b&gt;Course-Manager &amp;amp; Swarm Secrets&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;密钥挂载：/run/secrets/jwt_private.pem &amp;amp; jwt_public.pem&lt;br&gt;口令挂载：db_password · mysql_root_password · admin_password&lt;br&gt;滚动策略：stop-first · failure_action=rollback" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
          <mxGeometry x="1790.0" y="880.0" width="730.0" height="185.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-swarm-deployment-c14" value="&lt;div style=&quot;font-size:15px&quot;&gt;«node» worker (rbac.role=database)&lt;/div&gt;&lt;b&gt;rbac_mysql · MySQL 8.4.8 数据库容器 (:3306)&lt;/b&gt;&lt;hr style=&quot;border-color:#17365D&quot;&gt;仅内网 rbac-net 可达（不映射公网 3306 端口）　数据卷：/root/rbac/mysql/data -&amp;gt; /var/lib/mysql&lt;br&gt;共享库 rbac1（18 张业务与会话表）：两套 RBAC1 后端共用同一套表结构、RSA 公私钥与 Argon2 密码摘要" style="rounded=0;html=1;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=2.0;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;" vertex="1" parent="1">
