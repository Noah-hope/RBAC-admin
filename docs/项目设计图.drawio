  </diagram><diagram id="rbac1-ddd-domain-model" name="RBAC1-DDD-类图-领域模型全景">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="1830" background="#FFFFFF" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="0" />
