        <mxCell id="rbac1-ddd-domain-model-c12" value="+ subtreeOf(rootId: long): Set&amp;lt;Long&amp;gt;&lt;br&gt;+ ensureCanMove(departmentId, newParentId): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;fontStyle=1;whiteSpace=nowrap;" vertex="1" parent="rbac1-ddd-domain-model-c9">
