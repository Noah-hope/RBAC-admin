="2330.4" y="2710.0" width="655.4" height="28.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-e49" value="" style="html=1;endArrow=block;endFill=1;endSize=11;strokeWidth=2;strokeColor=#17365D;rounded=0;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="801.4" y="2828.0" as="sourcePoint"/><mxPoint x="810.4" y="2854.0" as="targetPoint"/><Array as="points"><mxPoint x="847.4" y="2828.0"/><mxPoint x="847.4" y="2854.0"/></Array></mxGeometry></mxCell><mxCell id="rbac1-ddd-seq-creation-c50" value="&lt;span style=&quot;background:#FFFFFF;padding:0 3px&quot;&gt;20. result = views(List.of(request), hierarchy).getFirst()&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=FangSong, STFangsong, serif;fontSize=19;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="807.4" y="2798.0" width="631.1" height="28.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-e51" value="" style="html=1;endArrow=open;endFill=0;endSize=12;strokeWidth=1.8;strokeColor=#17365D;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="783.4" y="2924.0" as="sourcePoint"/><mxPoint x="277.4" y="2924.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rbac1-ddd-seq-creation-c52" value="&lt;span style=&quot;background:#FFFFFF;padding:0 3px&quot;&gt;result: RoleCreationRequestResult&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=FangSong, STFangsong, serif;fontSize=19;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="347.8" y="2894.0" width="365.1" height="28.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-c111" value="RBAC1 面向对象顺序图 · 审批角色创建申请" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="30.0" width="4693.0" height="60.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-c112" value="范围：RoleCreationRequestApplicationService.review（@Transactional）。审批通过时调用 RoleApplicationService.create，按父角色最新配置重新校验。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="92.0" width="4693.0" height="34.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-c113" value="" style="line;strokeWidth=1.5;strokeColor=#B3C5D4;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="132.0" width="4693.0" height="4.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-c114" value="同步消息：实线实心箭头并编号；回复与异常：虚线空心箭头，不编号；«create» 为创建消息。«MetaClass» : Role 表示静态工厂方法 createBusiness。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="3014.0" width="1461.6" height="30.0" as="geometry"/></mxCell><mxCell id="rbac1-ddd-seq-creation-c115" value="create 加入同一事务：任一异常都使事务回滚，申请保持“待审核”；成功时角色、直接权限、继承关系、审批结果和操作记录一起提交，不给员工分配角色。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="3048.0" width="1440.8" height="30.0" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
