          <mxGeometry x="40.0" y="132.0" width="4749.0" height="4.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-creation-c114" value="同步消息：实线实心箭头并编号；回复与异常：虚线空心箭头，不编号；«create» 为创建消息。«MetaClass» : Role 表示静态工厂方法 createBusiness。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="3014.0" width="1461.6" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-seq-creation-c115" value="create 加入同一事务：任一异常都使事务回滚，申请保持“待审核”；成功时角色、直接权限、继承关系、审批结果和操作记录一起提交，不给员工分配角色。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="3048.0" width="1440.8" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
