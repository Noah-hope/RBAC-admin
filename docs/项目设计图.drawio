        <mxCell id="db-rel-log-targets" value="操作对象" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;whiteSpace=nowrap;noEdgeStyle=1;rounded=0;strokeWidth=3;strokeColor=#17365D;fontSize=16;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=13;endSize=13;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;labelWidth=130;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db-operation-log" target="db-operation-target" kind="database-relationship">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="52" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="db-note-authorization" value="" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;fillColor=#F4F8FC;strokeColor=#CCD9E6;rounded=0;" vertex="1" parent="1" kind="note-box">
          <mxGeometry x="72" y="1261" width="520" height="346" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-title" value="授权与会话" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=19;fontColor=#17365D;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1269" width="492" height="28" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-1" value="角色类型为 BUSINESS、TOTAL_ADMIN 或 DEPARTMENT_ADMIN。后两种为系统预置角色。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1305" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-2" value="管理角色通过用户角色表分配。部门管理员的范围从用户所属部门推导，业务角色分配接口只接受 BUSINESS。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1353" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-3" value="菜单的 parent_id 为空。按钮须指向同应用的菜单。角色勾选按钮时也须勾选所属菜单。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1401" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-4" value="权限标识按原值精确匹配，UQ(application_id, code)。关联表用联合主键防止重复授权。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1449" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-5" value="用户状态默认 ACTIVE，另有 DISABLED。密码只存哈希。退出或停用时删除对应会话，过期会话无效。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1497" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-authorization-6" value="应用接入时配置独立随机令牌。应用及会话只存令牌的 SHA-256 摘要。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="86" y="1545" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency" value="" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;fillColor=#F4F8FC;strokeColor=#CCD9E6;rounded=0;" vertex="1" parent="1" kind="note-box">
          <mxGeometry x="744" y="1261" width="520" height="346" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-title" value="数据约束与操作记录" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=19;fontColor=#17365D;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1269" width="492" height="28" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-1" value="顶层部门可无上级，组织树禁止循环。新建用户须选部门，预置总管理员可无部门。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1305" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-2" value="外键列有索引，已被主键或索引前缀覆盖的列复用现有索引。外键删除规则为 RESTRICT。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1353" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-3" value="角色权限替换、用户批量授权等使用事务，按固定顺序锁定相应角色或用户行，变更和成功记录一起提交。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1401" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-4" value="日志范围为 GLOBAL 或 USER_SCOPE。结果为 SUCCESS 或 FAILURE。业务对象和操作人信息保存当时的快照。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1449" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-5" value="用户管理记录须保存对象的部门快照。部门管理员先按快照筛选，再搜索、分页。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1497" width="492" height="45" as="geometry" />
        </mxCell>
        <mxCell id="db-note-consistency-6" value="批量日志正文只存共用信息。部门索引为 (department_id_at_event, operation_log_id)。" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontColor=#39556F;" vertex="1" parent="1" kind="note">
          <mxGeometry x="758" y="1545" width="492" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
