        </mxCell>
        <mxCell id="rbac1-ddd-domain-model-c5" value="Department" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#D9E6F2;swimlaneFillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=1.8;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=22;fontColor=#14283D;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="159.3" y="228.5" width="561.4" height="243.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-domain-model-c6" value="- id: Long&lt;br&gt;- name: String&lt;br&gt;- parentId: Long" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=FangSong, STFangsong, serif;fontSize=18;fontColor=#14283D;fontStyle=1;whiteSpace=nowrap;" vertex="1" parent="rbac1-ddd-domain-model-c5">
