        <mxCell id="rbac1-ddd-seq-creation-c112" value="范围：RoleCreationRequestApplicationService.review（@Transactional）。审批通过时调用 RoleApplicationService.create，按父角色最新配置重新校验。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
