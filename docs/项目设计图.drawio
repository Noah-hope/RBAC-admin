      <mxCell id="rbac1db-inheritance-child" parent="1" source="rbac1db-db-role" target="rbac1db-role-inheritance" edge="1" value="继承方" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#B91C1C;whiteSpace=nowrap;noEdgeStyle=1;edgeStyle=none;rounded=0;strokeWidth=3;strokeColor=#B91C1C;fontSize=24;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=15;endSize=15;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.24;entryX=1;entryY=0.3618421052631579;exitPerimeter=0;entryPerimeter=0;align=center;verticalAlign=middle;">
