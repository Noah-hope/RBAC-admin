        <mxCell id="rbac1-structured-seq-creation-c92" value="同步消息：实线实心箭头并编号；回复与异常：虚线空心箭头，不编号。«MetaClass» 表示静态方法调用（CloneFactory.copy、DuplicateKeys.saveAndFlush）。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2684.0" width="1625.4" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-structured-seq-creation-c93" value="RoleService.create 加入同一事务：任一校验或重名异常都会使整个事务回滚，申请保持“待审核”；与 DDD 版对比，审批状态变更直接由 Service 改写贫血实体字段。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=20;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="2718.0" width="1657.4" height="30.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
