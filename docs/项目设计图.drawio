        <mxCell id="db-rel-permission-tree" value="按钮所属菜单" style="html=1;whiteSpace=wrap;fontFamily=SimSun;fontStyle=1;fontColor=#14283D;whiteSpace=nowrap;noEdgeStyle=1;rounded=0;strokeWidth=3;strokeColor=#17365D;fontSize=16;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=13;endSize=13;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;labelWidth=130;exitX=0.58;exitY=0;entryX=0.91;entryY=0;" edge="1" parent="1" source="db-permission" target="db-permission" kind="database-relationship">
