        </mxCell>
        <mxCell id="rbac1-ddd-package-e38" value="" style="html=1;rounded=0;edgeStyle=none;strokeWidth=2.6;strokeColor=#17365D;endArrow=open;endFill=0;endSize=16;dashed=1;dashPattern=10 7;" edge="1" parent="1">
