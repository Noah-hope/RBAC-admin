  <diagram id="rbac1-ddd-class-creation" name="RBAC1-DDD-类图-角色创建申请审批">
    <mxGraphModel grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3990" pageHeight="1925" background="#FFFFFF" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rbac1-ddd-class-creation-c1" value="RBAC1 面向对象类图 · 角色创建申请审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=SimHei, Heiti SC, sans-serif;fontSize=40;fontColor=#14283D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="30.0" width="3890.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="rbac1-ddd-class-creation-c2" value="范围：总管理员审批角色创建申请（POST /role-creation-requests/{id}/review）。通过时复用 RoleApplicationService.create，按父角色最新配置重新校验。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=FangSong, STFangsong, serif;fontSize=21;fontColor=#3A5570;fontStyle=1;" vertex="1" parent="1">
