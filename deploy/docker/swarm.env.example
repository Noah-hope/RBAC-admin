# Non-secret deployment variables. Copy outside Git, fill values, then export in manager shell.
# Example: set -a; . /etc/rbac-deploy/swarm.env; set +a
# Use shell-safe literal values. Do not put passwords or key material here.
RBAC_BACKEND_IMAGE=swr.REGION.myhuaweicloud.com/ORGANIZATION/rbac-backend:COMMIT
RBAC_FRONTEND_IMAGE=swr.REGION.myhuaweicloud.com/ORGANIZATION/rbac-frontend:COMMIT
RBAC_MYSQL_IMAGE=mysql:8.4.8
# Base-image tags are defaults; record/pin tested digests before release.
RBAC_RELEASE=release1
RBAC_ADMIN_KEY_ID=REPLACE_WITH_ADMIN_JWK_KID
RBAC_IDEMPOTENCY_CURRENT_KEY_ID=server-v1
RBAC_MYSQL_DATA=/srv/rbac-mysql/data
RBAC_IMPORTS=/srv/rbac-admin/imports
RBAC_HTTP_PORT=80
RBAC_HTTPS_PORT=443
# Keep zero until MySQL, migration and initial admin have been checked.
RBAC_BACKEND_REPLICAS=0
RBAC_FRONTEND_REPLICAS=0
