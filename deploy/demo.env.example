# 显式短进程工具环境模板；复制到受控本机文件或IDE运行配置，不提交真实值。
RBAC_DEMO_MODE=demo
RBAC_DEMO_URL=jdbc:mysql://127.0.0.1:3306/rbac_admin_test
RBAC_DEMO_USER=rbac_app
RBAC_DEMO_PASSWORD=replace_locally
RBAC_DEMO_CONFIRM_DATABASE=rbac_admin_test
RBAC_DEMO_SERVICE_ID=00000000-0000-4000-8000-000000000031
RBAC_DEMO_SUBJECT=local-demo-oa
RBAC_DEMO_KIND=OA
# BUSINESS时填写真实已登记systemId；OA时不填写。
# RBAC_DEMO_SYSTEM_ID=
RBAC_DEMO_SIGNING_JWK=/replace/with/local/oa-signing.json
# 多私钥JWK Set时选择kid；单密钥无需填写。
# RBAC_DEMO_SIGNING_KEY_ID=local-oa-v1
RBAC_DEMO_VERIFY_JWK_SET=/replace/with/local/oa-trust.json
RBAC_DEMO_OUTPUT=/replace/with/private/directory/oa-callback.jwt
# 默认OA issuer=urn:rbac:oa，BUSINESS issuer=urn:rbac:business；必须与正常后端一致。
# RBAC_DEMO_ISSUER=urn:rbac:oa
# Python演示回调工具使用这两项，token不作为命令行参数。
RBAC_DEMO_BASE_URL=http://127.0.0.1:8080
RBAC_DEMO_CALLBACK_TOKEN_FILE=/replace/with/private/directory/oa-callback.jwt
