# Include inside nginx's http context; replace domain and certificate paths.
server {
    listen 80;
    server_name rbac.example.invalid;
    return 308 https://rbac.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name rbac.example.invalid;
    ssl_certificate /etc/rbac-admin/tls/fullchain.pem;
    ssl_certificate_key /etc/rbac-admin/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;
    # Do not persist URL query parameters (which can contain sensitive search input).
    access_log off;
    location = /actuator/health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /actuator/ { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Server creates request IDs; client identity remains the Bearer token.
        proxy_set_header X-Request-ID "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location / { return 404; }
}
