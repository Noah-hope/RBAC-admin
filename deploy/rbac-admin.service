[Unit]
Description=RBAC administration API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rbac-admin
Group=rbac-admin
WorkingDirectory=/var/lib/rbac-admin
EnvironmentFile=/etc/rbac-admin/server.env
ExecStart=/usr/bin/java -jar /opt/rbac-admin/current/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rbac-admin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
