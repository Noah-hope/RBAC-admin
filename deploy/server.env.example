# Copy outside the repository to /etc/rbac-admin/server.env (root-owned, mode 0600).
# systemd EnvironmentFile syntax: KEY=value, no export and no shell substitution.
SPRING_PROFILES_ACTIVE=server
RBAC_INSTANCE_ID=server-01
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/rbac_admin_server
SPRING_DATASOURCE_USERNAME=rbac_app
SPRING_DATASOURCE_PASSWORD=
RBAC_IMPORT_DIRECTORY=/var/lib/rbac-admin/imports
RBAC_IDENTITY_ENABLED=true
RBAC_ADMIN_KEY_ID=
RBAC_ADMIN_JWK_SET=/etc/rbac-admin/keys/admin-private.json
RBAC_BUSINESS_JWK_SET=/etc/rbac-admin/keys/business-public.json
RBAC_OA_JWK_SET=/etc/rbac-admin/keys/oa-public.json
RBAC_IDEMPOTENCY_ENABLED=true
RBAC_IDEMPOTENCY_CURRENT_KEY_ID=
# Example shape only: '{"server-v1":"BASE64_OF_AT_LEAST_32_RANDOM_BYTES"}'
RBAC_IDEMPOTENCY_KEYS_JSON=
