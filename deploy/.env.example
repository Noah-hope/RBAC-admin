# 复制为 deploy/.env；由 deploy.sh 导入。只填写非敏感配置，不填写密码或私钥。
STACK_NAME=rbac
DATABASE_STACK_NAME=rbac-db
STRUCTURED_IMAGE=registry.example.com/your-project/rbac1-structured:1.0.0
DDD_IMAGE=registry.example.com/your-project/rbac1-ddd:1.0.0
FRONTEND_IMAGE=registry.example.com/your-project/rbac-frontend:1.0.0

# structured 或 ddd；切换只更新前端的 API 转发目标，不重建前端镜像。
FRONTEND_BACKEND=structured
FRONTEND_PORT=8088
RBAC_NETWORK=javaee-proxy

# MySQL 在数据库服务器以 Swarm 服务运行，首次空数据卷时自动创建库和专用账号。
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=rbac1
RBAC1_DB_USERNAME=rbac1_app
RBAC1_DB_URL="jdbc:mysql://${DATABASE_STACK_NAME}_mysql:3306/${MYSQL_DATABASE}?serverTimezone=Asia/Shanghai"
MYSQL_MEMORY_LIMIT=1024M
MYSQL_MEMORY_RESERVATION=512M
RBAC1_ADMIN_USERNAME=admin

# 改为固定的正式访问地址。课程系统配置的 issuer 必须与此一致。
# 下列地址只是示例；生产入口应由现有网关提供 HTTPS。
RBAC1_JWT_ISSUER=https://rbac.example.com
# 同源前端无需跨域；包含课程前端等确实需要直连的浏览器来源，逗号分隔。
RBAC1_CORS_ALLOWED_ORIGINS=https://rbac.example.com

DB_PASSWORD_SECRET=rbac_db_password_v1
MYSQL_ROOT_PASSWORD_SECRET=rbac_mysql_root_password_v1
ADMIN_PASSWORD_SECRET=rbac_admin_password_v1
JWT_PRIVATE_SECRET=rbac_jwt_private_v1
JWT_PUBLIC_SECRET=rbac_jwt_public_v1

# 首次部署为 0，结构化后端初始化成功后再改为 1。
DDD_REPLICAS=0
BACKEND_MEMORY_LIMIT=1024M
BACKEND_MEMORY_RESERVATION=512M
FRONTEND_MEMORY_LIMIT=128M
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70'
BACKEND_LOG_LEVEL=INFO
