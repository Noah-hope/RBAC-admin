[Unit]
Description=RBAC explicit database migration (run only while API is stopped)
After=network-online.target
Conflicts=rbac-admin.service
Before=rbac-admin.service

[Service]
Type=oneshot
User=rbac-admin
Group=rbac-admin
WorkingDirectory=/var/lib/rbac-admin
EnvironmentFile=/etc/rbac-admin/migrate.env
ExecStart=/usr/bin/java -Dloader.main=com.adgn.backend.migration.MigrationApplication -cp /opt/rbac-admin/current/app.jar org.springframework.boot.loader.launch.PropertiesLauncher
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
